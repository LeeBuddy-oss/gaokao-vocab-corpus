          "year": 2026,
          "t": "预付停车费。"
        },
        {
          "s": "Interlibrary Loan Fees",
          "src": "2025浙江1月卷·阅读理解A",
          "cat": "gaokao",
          "year": 2025,
          "t": "馆际互借费用。"
        },
        {
          "s": "Pay an extra fee for delivery.",
          "src": "2025浙江1月卷·阅读理解A",
          "cat": "gaokao",
          "year": 2025,
          "t": "为配送支付额外费用。"
        },
        {
          "s": "•Fees: $365 per week.",
          "src": "2023浙江1月卷·阅读理解A",
          "cat": "gaokao",
          "year": 2023,
          "t": "•费用：每周365美元。"
        },
        {
          "s": "Scholarships are for Group Play admission fees and/or transportation.",
          "src": "2022全国新高考II卷·阅读理解A",
          "cat": "gaokao",
          "year": 2022,
          "t": "奖学金可用于团体游玩门票和/或交通费用。"
        },
        {
          "s": "Prepay the admission fees.",
          "src": "2022全国新高考II卷·阅读理解A",
          "cat": "gaokao",
          "year": 2022,
          "t": "预付入场费。"
        },
        {
          "s": "Pay a registration fee.",
          "src": "2021新高考II卷·阅读理解A",
          "cat": "gaokao",
          "year": 2021,
          "t": "支付注册费。"
        },
        {
          "s": "If your card has been lost, a fee of £5 is charged for the production of a replacement card.",
          "src": "2020天津3月卷·阅读理解A",
          "cat": "gaokao",
          "year": 2020,
          "t": "如果你的卡丢失，补发卡将收取5英镑费用。"
        },
        {
          "s": "When I post the picture online, I will make a comment about how bad it is to feed wild crocodiles.",
          "src": "外研社B2 U5",
          "cat": "waiyan",
          "t": "当我在网上发布图片时，我会评论喂养野生鳄鱼有多糟糕。"
        },
        {
          "s": "Thinking on his feet, Lin started to tell a story about a cruel Roman emperor who tried to feed a man to wild animals.",
          "src": "外研社B4 U1",
          "cat": "waiyan",
          "t": "林语堂灵机一动，开始讲一个故事，关于一位残忍的罗马皇帝试图把一个人喂给野兽。"
        },
        {
          "s": "The boats drive them away from the places where they feed and interrupt their routine of resting and taking care of their young.",
          "src": "外研社B4 U6",
          "cat": "waiyan",
          "t": "船只把它们从觅食的地方赶走，打扰了它们休息和照顾幼崽的日常。"
        },
        {
          "s": "They feed on green plants.",
          "src": "外研社B5 U5",
          "cat": "waiyan",
          "t": "它们以绿色植物为食。"
        }
      ]
    }
