  "defs": [
    {
      "def": "a structure made of metal bars or wire in which animals or birds are kept 笼子verbadj.",
      "ex": [
        {
          "s": "Though not known to use tools in the wild, the birds have proved skilful at tool use while kept in the cage.",
          "src": "2022全国甲卷·阅读理解B",
          "cat": "gaokao",
          "year": 2022,
          "t": "虽然它们在野外不被认为会使用工具，但这些鸟在被关在笼子里时证明了自己善于使用工具。"
        },
        {
          "s": "Instead of being kept in cages, wildlife can move about freely.",
          "src": "人教B2 U5",
          "cat": "renjiao",
          "year": "",
          "t": "野生动物不再被关在笼子里，而是可以自由活动。"
        },
        {
          "s": "But maybe it’s too good to be true … Susan: Yeah, what if we have to clean out the smelly cages?",
          "src": "人教选必4 U4",
          "cat": "renjiao",
          "year": "",
          "t": "但也许这好得不像真的……苏珊：是啊，要是我们得清理那些臭烘烘的笼子怎么办？"
        },
        {
          "s": "How about you clean the outside of the cages, and I’ll clean the inside?",
          "src": "人教选必4 U4",
          "cat": "renjiao",
          "year": "",
          "t": "你清理笼子外面，我清理里面，怎么样？"
        },
        {
          "s": "I don't like to see animals in cages.",
          "src": "北师大选必3 U9",
          "cat": "beishida",
          "year": "",
          "t": "我不喜欢看到动物被关在笼子里。"
        },
        {
          "s": "Cages aren't always bad for the animals.",
          "src": "北师大选必3 U9",
          "cat": "beishida",
          "year": "",
          "t": "笼子并不总是对动物有害。"
        }
      ]
    }
  ],
